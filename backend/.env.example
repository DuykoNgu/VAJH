# Mỗi nhóm dưới đây ứng với một file trong app/config/ (tên biến = tên field, viết hoa)

# ---------------------------------------------------------------------------
# core.py: môi trường, danh tính dev, database, Redis, lưu file, CORS
# ---------------------------------------------------------------------------
# Môi trường: development | test | production
APP_ENV=development

# Danh tính dev (chưa có đăng nhập tới giai đoạn 12 - authentication)
# Header X-Dev-User: <username> chọn người dùng; không có header thì dùng mặc định dưới đây
AUTH_MODE=dev
DEV_STUDENT_USERNAME=minh8a
DEV_TEACHER_USERNAME=colan

REDIS_URL="redis://localhost:6379"
# Neon: `neon link` tự ghi đè 2 dòng dưới. Docker local: giữ nguyên.
DATABASE_URL="postgresql://lusia:lusia@localhost:5432/lusia_db"
# URL không qua pooler, dùng cho migration (python -m app.migrate)
DATABASE_URL_UNPOOLED="postgresql://lusia:lusia@localhost:5432/lusia_db"

# Object Storage (MinIO local; bỏ S3_ENDPOINT_URL khi dùng AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lusia
S3_ACCESS_KEY=lusia
S3_SECRET_KEY=lusia_minio_password

# File PDF/ảnh hình lưu ở FILES_DIR (tạm, tới khi có S3)
FILE_STORE=local
# FILES_DIR=data/files

# CORS: các origin của frontend, cách nhau bằng dấu phẩy
FRONTEND_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# ai.py: LLM (development/test có thể bỏ trống nếu dùng provider "fake")
# ---------------------------------------------------------------------------
# LLM: openai (mặc định) | anthropic | fake (mặc định khi APP_ENV=test)
LLM_PROVIDER=openai
# Dùng cho LLM (provider openai)
OPENAI_API_KEY="your_openai_api_key"
# Model OpenAI cho mọi agent (chọn từ danh sách model của key); bắt buộc ở production
OPENAI_LLM_MODEL=
# Chỉ cần khi LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY="your_anthropic_api_key"
# Đổi model/effort cho từng agent (chỉ ghi route cần đổi), ví dụ:
# LLM_ROUTES={"orchestrator": {"model": "<model-nhanh>", "effort": "low"}}
# LLM_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# rag.py: cắt đoạn, embedding, số đoạn tìm về
# ---------------------------------------------------------------------------
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200
# Embedding chạy local bằng sentence-transformers (tải ~2.3GB lần đầu vào ~/.cache/huggingface)
# EMBEDDING_PROVIDER=local     # local | fake
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2
# RAG_TOP_K=6                  # số đoạn Knowledge Agent lấy về cho mỗi câu hỏi

# ---------------------------------------------------------------------------
# documents.py: nạp tài liệu
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PAGES=400
FIGURE_MIN_AREA_RATIO=0.02
# Số lời gọi LLM song song khi OCR/mô tả hình
LLM_CONCURRENCY=4
INGEST_TIMEOUT_S=3600
# OUTLINE_ON_INGEST=true
# LOCAL_OCR=true
# LAYOUT_MODEL_PATH=data/models/doclayout/doclayout_yolo_docstructbench_imgsz1024.pt

# ---------------------------------------------------------------------------
# learning.py: học sinh học bài
# ---------------------------------------------------------------------------
# PREFETCH_PARTS=true

# ---------------------------------------------------------------------------
# voice.py: giọng nói
# ---------------------------------------------------------------------------
# TTS_PROVIDER=zerotts         # zerotts | fake (mặc định khi APP_ENV=test)
# ZEROTTS_MODEL_DIR=data/models/zerotts
# ZEROTTS_VOICE=baotrang

# ---------------------------------------------------------------------------
# monitor.py: trace agent + LLM (trang /monitor)
# ---------------------------------------------------------------------------
# TRACE_PAYLOADS=sampled       # all | sampled
# TRACE_SAMPLE_RATE=0.25
# TRACE_PAYLOAD_DAYS=7
# TRACE_KEEP_DAYS=90
# LLM_PRICE_IN_PER_M=
# LLM_PRICE_OUT_PER_M=
